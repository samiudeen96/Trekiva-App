# --- Shopify (filled by `shopify app dev` / `shopify app env pull`) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_customers,write_customers,read_discounts,write_discounts,read_orders

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://welcome:welcome@localhost:5432/welcome_popup

# --- Public endpoint security ---
# Random 32+ byte secret used to sign short-lived anti-bot form tokens.
CLAIM_TOKEN_SECRET=

# --- Email delivery: resend | postmark | sendgrid | smtp | log ---
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=care@trekiva.com
EMAIL_FROM_NAME=Trekiva
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
