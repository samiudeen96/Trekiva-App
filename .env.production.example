# Copy to .env.production on the VM and fill in. Never commit the real file.
# Native (no Docker) install: also add
#   DATABASE_URL=postgresql://welcome:<POSTGRES_PASSWORD>@localhost:5432/welcome_popup
# DNS A record must point to the VM's IP
APP_DOMAIN=app.trekiva.com
POSTGRES_PASSWORD=change-me-long-random

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.trekiva.com
SCOPES=read_customers,write_customers,read_discounts,write_discounts,read_orders

# openssl rand -hex 32
CLAIM_TOKEN_SECRET=

EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=care@trekiva.com
EMAIL_FROM_NAME=Trekiva
RESEND_API_KEY=
